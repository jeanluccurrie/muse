# Copy this file to .env.local and fill in values for local development.
# .env.local is gitignored and never committed.

# The password users type to access MUSE (you choose this)
MUSE_AUTH_PASSWORD=your-password-here

# Neon Postgres connection string (from Vercel dashboard → Storage → your database)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname

# Vercel Blob token (from Vercel dashboard → Storage → your blob store)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
